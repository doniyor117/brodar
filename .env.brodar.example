# Store real values outside the source checkout. Never commit credentials.
BRODAR_BRAIN=codex
BRODAR_CODEX_MODEL=gpt-6-luna
BRODAR_CODEX_EFFORT=low
BRODAR_CLAUDE_MODEL=claude-sonnet-4-6
BRODAR_CLAUDE_EFFORT=high
BRODAR_DATABASE_URL=
TELEGRAM_BOT_TOKEN=
GOOGLE_AI_API_KEY=
BRODAR_ALLOWED_CHATS=
BRODAR_OWNER_IDS=
BRODAR_INSTANCE_ID=brodar
BRODAR_DEBOUNCE_SECONDS=1.5
BRODAR_AMBIENT_INTERVAL=30
BRODAR_TIMEZONE=UTC
BRODAR_MAX_CONCURRENT_TURNS=2
# BRODAR_RUNTIME_DIR=/absolute/external/runtime/path
# BRODAR_STORAGE_CONFIG=/absolute/private/storage-production.json

# Optional Brodar-only Codex compaction threshold (unset: model default).
BRODAR_CODEX_AUTO_COMPACT_TOKEN_LIMIT=80000
# Maximum foreground wait for optional recall query embedding.
BRODAR_RECALL_TIMEOUT_SECONDS=2

# One explicit primary owner; no instance identity is inherited from this example.
BRODAR_RESEARCH_TRANSPORT=disabled
BRODAR_TEMP_BUDGET_BYTES=500000000
BRODAR_RETAINED_BUDGET_BYTES=1000000000
BRODAR_BACKUP_BUDGET_BYTES=2000000000
BRODAR_TEMP_IDLE_SECONDS=604800
BRODAR_CLEANUP_INTERVAL_SECONDS=604800
BRODAR_BACKUP_INTERVAL_SECONDS=1209600
